{
  "name": "lens-translate",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "译镜 — Windows 屏幕与文本翻译",
  "author": "Rongji",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build && npm run build:electron",
    "start": "electron .",
    "test": "tsx --test electron/*.test.ts tests/*.test.ts",
    "test:ui": "node tests/electron-smoke.cjs",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.rongji.lens-translate",
    "productName": "Lens Translate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": ["lens.ico", "lens.png"]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/lens.ico",
      "signAndEditExecutable": true
    },
    "artifactName": "Lens-Translate-${version}-${arch}.${ext}"
  }
}
